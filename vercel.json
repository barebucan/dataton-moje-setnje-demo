{
  "buildCommand": "node build.mjs",
  "outputDirectory": "public",
  "framework": null,
  "functions": {
    "api/index.py": {
      "includeFiles": "api/runtime/**",
      "maxDuration": 120
    }
  },
  "rewrites": [
    {
      "source": "/wp-json/lagano/v1/scene",
      "destination": "/data/scene.json"
    },
    {
      "source": "/wp-json/lagano/v1/:endpoint",
      "destination": "/api/index.py"
    },
    {
      "source": "/wp-admin/admin-post.php",
      "destination": "/api/index.py"
    },
    {
      "source": "/voice/places",
      "destination": "/voice/places.json"
    },
    {
      "source": "/voice/route",
      "destination": "/voice/route.json"
    },
    {
      "source": "/voice/status",
      "destination": "/api/index.py"
    },
    {
      "source": "/voice/sessions",
      "destination": "/api/index.py"
    },
    {
      "source": "/voice/realtime/:sid",
      "destination": "/api/index.py"
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "X-Frame-Options",
          "value": "DENY"
        }
      ]
    }
  ]
}